# === OBLIGATORY ===
BYBIT_REF_LINK=https://www.bybit.com/invite?ref=YOUR_CODE

# === TELEGRAM (создать бота через @BotFather) ===
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklmNOPqrstUVwxyz
TELEGRAM_CHANNEL_ID=@your_channel_username

# === TWITTER/X (опционально — платный, от $100/мес) ===
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# === DISCORD (бесплатно — webhook URL из канала) ===
# Создать: ПКМ по каналу → Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=

# === BLUESKY (бесплатно — handle + app password) ===
# App password: Settings → Privacy & Security → App Passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
